# Compose Multiplatform UI Standards

## Screen Structure

```kotlin
// ✅ GOOD - Screen recibe ViewModel y callbacks
@Composable
fun LoginClienteScreen(
    viewModel: AuthViewModel,
    onNavigateToRegister: () -> Unit,
    onLoginSuccess: (User) -> Unit
) {
    var email by remember { mutableStateOf("") }
    var password by remember { mutableStateOf("") }
    
    Column(
        modifier = Modifier.fillMaxSize().padding(16.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        TextField(
            value = email,
            onValueChange = { email = it },
            label = { Text("Email") }
        )
        
        TextField(
            value = password,
            onValueChange = { password = it },
            label = { Text("Contraseña") },
            visualTransformation = PasswordVisualTransformation()
        )
        
        if (viewModel.isLoading) {
            CircularProgressIndicator()
        } else {
            Button(
                onClick = {
                    viewModel.loginCliente(
                        email = email,
                        password = password,
                        onSuccess = onLoginSuccess,
                        onError = { /* mostrar error */ }
                    )
                }
            ) {
                Text("Iniciar Sesión")
            }
        }
    }
}

// ❌ BAD - Screen maneja lógica de negocio directamente
@Composable
fun LoginScreen() {
    var email by remember { mutableStateOf("") }
    var password by remember { mutableStateOf("") }
    
    Button(onClick = {
        // ❌ NO hacer esto en el Composable
        if (email.isNotEmpty() && password.isNotEmpty()) {
            val user = database.authenticateUser(email, password)
            if (user != null) {
                navController.navigate("home")
            }
        }
    }) {
        Text("Login")
    }
}
```

## State Management

```kotlin
// ✅ GOOD - state hoisting y remember
@Composable
fun UserForm(
    initialName: String = "",
    onSubmit: (String) -> Unit
) {
    var name by remember { mutableStateOf(initialName) }
    
    Column {
        TextField(
            value = name,
            onValueChange = { name = it }
        )
        Button(onClick = { onSubmit(name) }) {
            Text("Guardar")
        }
    }
}

// ❌ BAD - state no elevado, difícil de testear
@Composable
fun UserForm() {
    var name by remember { mutableStateOf("") }
    
    Column {
        TextField(value = name, onValueChange = { name = it })
        Button(onClick = {
            // ❌ Lógica acoplada
            saveToDatabase(name)
        }) {
            Text("Guardar")
        }
    }
}
```

## Loading States

```kotlin
// ✅ GOOD - mostrar loading y errores
@Composable
fun UserListScreen(viewModel: UserViewModel) {
    val users by viewModel.users.collectAsState(initial = emptyList())
    
    Box(modifier = Modifier.fillMaxSize()) {
        when {
            viewModel.isLoading -> {
                CircularProgressIndicator(
                    modifier = Modifier.align(Alignment.Center)
                )
            }
            viewModel.error != null -> {
                Column(
                    modifier = Modifier.align(Alignment.Center),
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Text(
                        text = viewModel.error!!,
                        color = MaterialTheme.colorScheme.error
                    )
                    Button(onClick = { viewModel.retry() }) {
                        Text("Reintentar")
                    }
                }
            }
            users.isEmpty() -> {
                Text(
                    text = "No hay usuarios",
                    modifier = Modifier.align(Alignment.Center)
                )
            }
            else -> {
                LazyColumn {
                    items(users) { user ->
                        UserItem(user = user)
                    }
                }
            }
        }
    }
}
```

## Modifiers

```kotlin
// ✅ GOOD - modifiers en orden recomendado
@Composable
fun CustomCard() {
    Box(
        modifier = Modifier
            .fillMaxWidth()           // 1. Tamaño
            .padding(16.dp)           // 2. Padding externo
            .background(Color.White)  // 3. Background
            .border(1.dp, Color.Gray) // 4. Border
            .padding(8.dp)            // 5. Padding interno
            .clickable { }            // 6. Interacción
    ) {
        Text("Contenido")
    }
}

// ❌ BAD - orden inconsistente de modifiers
Box(
    modifier = Modifier
        .clickable { }
        .background(Color.White)
        .fillMaxWidth()
        .padding(16.dp)
) { }
```

## Reusable Components

```kotlin
// ✅ GOOD - componentes reutilizables con parámetros
@Composable
fun PrimaryButton(
    text: String,
    onClick: () -> Unit,
    modifier: Modifier = Modifier,
    enabled: Boolean = true
) {
    Button(
        onClick = onClick,
        modifier = modifier,
        enabled = enabled,
        colors = ButtonDefaults.buttonColors(
            containerColor = MaterialTheme.colorScheme.primary
        )
    ) {
        Text(text)
    }
}

// Uso
PrimaryButton(
    text = "Guardar",
    onClick = { viewModel.save() },
    modifier = Modifier.fillMaxWidth()
)
```

## Navigation

```kotlin
// ✅ GOOD - navegación mediante callbacks
@Composable
fun WelcomeScreen(
    onNavigateToClienteLogin: () -> Unit,
    onNavigateToAbogadoLogin: () -> Unit
) {
    Column {
        Button(onClick = onNavigateToClienteLogin) {
            Text("Soy Cliente")
        }
        Button(onClick = onNavigateToAbogadoLogin) {
            Text("Soy Abogado")
        }
    }
}

// En el NavHost
composable("welcome") {
    WelcomeScreen(
        onNavigateToClienteLogin = { navController.navigate("cliente/login") },
        onNavigateToAbogadoLogin = { navController.navigate("abogado/login") }
    )
}

// ❌ BAD - Screen depende de NavController
@Composable
fun WelcomeScreen(navController: NavController) {
    // ❌ Acoplamiento fuerte
}
```

